{
  "name": "dubdt",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron --disable-http-cache --disk-cache-size=0 --media-cache-size=0 --disable-gpu-shader-disk-cache --disable-features=CalculateNativeWinOcclusion,SkiaGraphite,SkiaGraphiteUsePersistentCache . --dev",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron --disable-http-cache --disk-cache-size=0 --media-cache-size=0 --disable-gpu-shader-disk-cache --disable-features=CalculateNativeWinOcclusion,SkiaGraphite,SkiaGraphiteUsePersistentCache .",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.dubdt.studio",
    "productName": "DubDT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DubDT-Portable.exe"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "wavesurfer.js": "^8.0.1"
  }
}
